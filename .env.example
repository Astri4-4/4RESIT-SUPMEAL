# =========================================
# 4RESIT-SUPMEAL — Environment Variables
# =========================================
# Copy this file to server/.env and db/.env (see compose.yaml env_file mapping)
# and fill in real values. Never commit actual .env files.

# ---------- server/.env ----------

# Express server
PORT=3000

# JWT
JWT_SECRET=change_me_to_a_long_random_secret

# PostgreSQL connection (used by the app to reach the db service)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=supmeal

# Redis connection (used by the app to reach the redis service)
REDIS_HOST=redis
REDIS_PORT=6379

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ---------- db/.env ----------
# Consumed by the official postgres image (postgres:18-alpine)
# Keep these in sync with the POSTGRES_* values above

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=supmeal
