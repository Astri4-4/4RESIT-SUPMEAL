# Express server
PORT=3000

# JWT
JWT_SECRET=change_me_to_a_long_random_secret

# PostgreSQL connection (must match db/.env)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=supmeal

# Redis connection
REDIS_HOST=redis
REDIS_PORT=6379

# Rate limiting (set POINTS to -1 to disable rate limiting for that route)
RATE_LIMIT_LOGIN_POINTS=500
RATE_LIMIT_LOGIN_DURATION=60
RATE_LIMIT_LOGIN_BLOCK_DURATION=300

RATE_LIMIT_REGISTER_POINTS=300
RATE_LIMIT_REGISTER_DURATION=60
RATE_LIMIT_REGISTER_BLOCK_DURATION=600

RATE_LIMIT_GENERAL_POINTS=500
RATE_LIMIT_GENERAL_DURATION=60
RATE_LIMIT_GENERAL_BLOCK_DURATION=300

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback